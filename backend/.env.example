PORT=5050
NODE_ENV=development

# Optional — if omitted, the app falls back to in-memory seed data
# so the API works out of the box during development.
# Local dev default (after installing MongoDB Community Server):
MONGODB_URI=mongodb://127.0.0.1:27017/angular-physics

CLIENT_URL=http://localhost:5183
SITE_URL=https://www.angularphysics.com

# Required for auth (JWTs). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin login. Set BOTH to enable it. These credentials authenticate directly
# (no database row needed), so the admin can log in even with no MONGODB_URI set.
# The admin gets mentor-level (full dashboard) access.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@angularphysics.com
ADMIN_PASSWORD=

# Used once by `npm run seed:mentor` to create the single mentor account
MENTOR_SEED_EMAIL=mentor@angularphysics.com
MENTOR_SEED_PASSWORD=changeme

# Razorpay — required for premium notes / paid tests. Get test-mode keys from
# the Razorpay dashboard. Payment endpoints return a clear 503 until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# YouTube Data API v3 — powers the homepage "Latest Uploads" section. Get an
# API key from the Google Cloud Console and find your channel id under
# YouTube Studio > Settings > Channel > Advanced. Section stays hidden until
# both are set.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
