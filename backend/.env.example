PORT=5000
NODE_ENV=development

# Optional — if omitted, the app falls back to in-memory seed data
# so the API works out of the box during development.
MONGODB_URI=

CLIENT_URL=http://localhost:5173
SITE_URL=https://www.angularphysics.com

# Required for auth (JWTs). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used once by `npm run seed:mentor` to create the single mentor account
MENTOR_SEED_EMAIL=mentor@angularphysics.com
MENTOR_SEED_PASSWORD=changeme
